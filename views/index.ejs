</div></footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/clipxjs/dist/clipx.min.js"></script>
<script>
var clipx = new ClipX();
clipx.setCustomStyles({
  toast: "background:#1b1f2a;color:#fff;border:1px solid #353b4e;border-radius:10px;padding:10px 14px",
  error: "background:#3d1a1a;border-color:#7a2a2a"
});
clipx.attach();
(function () {
  var BASE = <%- JSON.stringify(baseUrl) %>, H = window.hljs;
  var $ = function (s) { return document.querySelector(s); }, $$ = function (s) { return [].slice.call(document.querySelectorAll(s)); };
  function mk(t, a, x) { var e = document.createElement(t); for (var k in a) e.setAttribute(k, a[k]); if (x) e.textContent = x; return e; }
  function q(v) { return String(v).replace(/&/g, "&amp;").replace(/"/g, "&quot;"); }


  function hl(c) {
    if (!H) return;
    delete c.dataset.highlighted; // allow re-highlighting
    H.highlightElement(c);
  }

  $$("pre.code:not(#pg-code) code").forEach(hl);

  $$("pre.code").forEach(function (p, i) {
    p.firstChild.id = "c" + i;
    p.appendChild(mk("button", { "class": "cp", "data-clipx-target": "#c" + i, "data-clipx-disable-msg": "", "data-clipx-msg": "Code copied" }, "Copy"));
  });
  $$("section[id] h2").forEach(function (h) {
    h.appendChild(mk("button", { "class": "lk", "aria-label": "Copy link", "data-clipx-text": BASE + "#" + h.parentNode.id, "data-clipx-disable-msg": "", "data-clipx-msg": "Link copied" }, "#"));
  });

  /* Playground */
  var S = { mode: "text", text: "  <b>Hello</b>   from ClipX!  ", src: "  <i>Edit me</i>,   then copy or cut  ", fmt: [], msg: "", pos: "bottom", dur: 1500, only: 0, nomsg: 0, notoast: 0 };
  var LABEL = { text: "Copy text", copy: "Copy element", cut: "Cut", paste: "Paste" };
  function render() {
    var a = {};
    if (S.mode == "text") a["data-clipx-text"] = S.text;
    else if (S.mode == "paste") a["data-clipx-paste"] = "#pg-dest";
    else { a["data-clipx-target"] = "#pg-src"; if (S.mode == "cut") a["data-clipx-cut"] = ""; }
    if (S.fmt.length) a["data-clipx-format"] = S.fmt.join(",");
    if (S.msg) a["data-clipx-msg"] = S.msg;
    if (S.pos == "top") a["data-clipx-toast-position"] = "top";
    if (S.dur != 1500) a["data-clipx-duration"] = S.dur;
    if (S.only) a["data-clipx-toast"] = "";
    if (S.nomsg) a["data-clipx-disable-msg"] = "";
    if (S.notoast) a["data-clipx-disable-toast"] = "";

    var box = $("#pg-prev"); box.textContent = "";
    var field = S.mode == "paste" ? mk("textarea", { id: "pg-dest", "class": "in", placeholder: "Pasted text appears here" })
      : S.mode == "text" ? null : mk("input", { id: "pg-src", "class": "in", value: S.src });
    field && box.appendChild(field);
    var btn = mk("button", a, LABEL[S.mode]); btn.className = "btn pri"; box.appendChild(btn);
    if (S.mode != "text") { var rs = mk("button", { type: "button", "class": "btn" }, "Reset"); rs.onclick = render; box.appendChild(rs); }
    var res = mk("div", { "class": "basis-full text-center font-mono text-xs break-all text-mute" });
    var out = clipx.format(S.mode == "text" ? S.text : S.src, S.fmt);
    res.textContent = (S.fmt.length ? S.fmt.join(" \u2192 ") + "  |  " : "") + (S.mode == "paste" ? "formats the pasted text" : out ? 'copies: "' + out + '"' : "nothing to copy");
    box.appendChild(res);

    var attrs = Object.keys(a).map(function (k) { return a[k] === "" ? "  " + k : "  " + k + '="' + q(a[k]) + '"'; }).join("\n");
    var html = (S.mode == "paste" ? '<textarea id="pg-dest"></textarea>\n' : S.mode == "text" ? "" : '<input id="pg-src" value="' + q(S.src) + '">\n')
      + "<button\n" + attrs + ">\n  " + LABEL[S.mode] + "\n</button>\n\n<script>\n  new ClipX().attach();\n<\/script>";
    var c = $("#pg-code code");
    c.textContent = html; // plain text first, which clears old highlight spans
    hl(c);
  }
  $$("[data-mode]").forEach(function (b) {
    b.onclick = function () {
      S.mode = b.dataset.mode;
      $$("[data-mode]").forEach(function (x) { x.classList.toggle("on", x == b); });
      $("#row-text").style.display = S.mode == "text" ? "" : "none";
      render();
    };
  });
  var CASE = ["uppercase", "lowercase", "capitalize", "titlecase"];
  function sync() {
    $$("[data-f]").forEach(function (b) {
      var on = S.fmt.indexOf(b.dataset.f) > -1;
      b.classList.toggle("on", on); b.setAttribute("aria-pressed", on);
    });
  }
  $$("[data-f]").forEach(function (b) {
    b.onclick = function () {
      var f = b.dataset.f, i = S.fmt.indexOf(f);
      if (i > -1) S.fmt.splice(i, 1);
      else {
        if (CASE.indexOf(f) > -1) S.fmt = S.fmt.filter(function (x) { return CASE.indexOf(x) < 0; }); // one case at a time
        S.fmt.push(f);
      }
      sync(); render();
    };
  });
  function bind(id, fn) { var e = $(id); e.oninput = e.onchange = function () { fn(e); render(); }; }
  bind("#in-text", function (e) { S.text = e.value; });
  bind("#in-msg", function (e) { S.msg = e.value; });
  bind("#in-pos", function (e) { S.pos = e.value; });
  bind("#in-dur", function (e) { S.dur = parseInt(e.value, 10) || 1500; });
  bind("#ck-only", function (e) { S.only = e.checked; });
  bind("#ck-nomsg", function (e) { S.nomsg = e.checked; });
  bind("#ck-notoast", function (e) { S.notoast = e.checked; });
  var links = $$("aside a");
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) links.forEach(function (a) { a.classList.toggle("on", a.hash == "#" + e.target.id); }); });
  }, { rootMargin: "-20% 0px -70% 0px" });
  $$("section[id]").forEach(function (x) { io.observe(x); });
  sync();
  render();
})();
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "ClipX JS",
  "description": "ClipX.JS is a tiny, dependency-free clipboard library for JavaScript with copy, cut, paste, text formatting and customizable toast notifications.",
  "url": "<%= baseUrl %>",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any",
  "license": "https://opensource.org/licenses/MIT",
  "softwareVersion": "1.3.0"
}
</script>
</body>
</html>
